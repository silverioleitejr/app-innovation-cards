# APP_ENV: Database and runtime environment selector.
# - "DEV" (default): Uses local SQLite database (better-sqlite3 via Kysely SqliteDialect).
# - "PRD": Uses PostgreSQL database (pg.Pool via Kysely PostgresDialect).
APP_ENV="DEV"

# --- SQLite Configuration (used when APP_ENV="DEV") ---
SQLITE_DB_PATH="db/innovation-board.db"

# --- PostgreSQL Configuration (used when APP_ENV="PRD") ---
# Configure discrete DB_* variables (or uncomment DATABASE_URL if preferred):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=disable"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="innovation_board"
DB_USER="postgres"
DB_PASSWORD="password"
DB_SSL="false"
DB_POOL_MAX="10"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
